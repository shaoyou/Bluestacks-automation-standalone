          "actions": [
            {
              "remark": "点击左下角红包",
              "type": "click",
              "x": 92,
              "y": 1329
            },
            {
              "remark": "等待0.31秒",
              "seconds": 0.31,
              "type": "wait"
            },
            {
              "remark": "点击开",
              "type": "click",
              "x": 550,
              "y": 900
            },
            {
              "remark": "等待0.1秒",
              "seconds": 0.1,
              "type": "wait"
            },
            {
              "remark": "点击开",
              "type": "click",
              "x": 550,
              "y": 900
            },
            {
              "remark": "等待0.1秒",
              "seconds": 0.1,
              "type": "wait"
            },
            {
              "remark": "点击开",
              "type": "click",
              "x": 550,
              "y": 900
            },
            {
              "remark": "等待0.1秒",
              "seconds": 0.1,
              "type": "wait"
            }
          ]
        },
        {
          "type": "if_image",
          "remark": "爆发期结束快速检查宝箱图标（查不到立即返回抢红包）",
          "templates": [
            "../image_templates/bl_baoxiaoxing_harmony_1260x2720.png",
            "../image_templates/bl_baoxiaoxing_1080x1920.png",
            "../image_templates/bl_baoxiaoxing.png"
          ],
          "region": {
            "x": 137,
            "y": 378,
            "width": 828,
            "height": 1191
          },
          "threshold": 0.88,
          "timeout_sec": 0.5,
          "interval_sec": 0.3,
          "then_actions": [
            {
              "remark": "识别到宝箱，暂停抢红包，稍等图标稳定",
              "seconds": 0.5,
              "type": "wait"
            },
            {
              "interval_sec": 0.6,
              "region": {
                "height": 1191,
                "width": 828,
                "x": 137,
                "y": 378
              },
              "remark": "识别图标bl_baoxiaoxing.png并点击",
              "threshold": 0.88,
              "timeout_sec": 8,
              "type": "find_image_click",
              "templates": [
                "../image_templates/bl_baoxiaoxing_harmony_1260x2720.png",
                "../image_templates/bl_baoxiaoxing_1080x1920.png",
                "../image_templates/bl_baoxiaoxing.png"
              ]
            },
            {
              "remark": "等待1秒",
              "seconds": 1,
              "type": "wait"
            },
            {
              "interval_sec": 0.6,
              "region": {
                "height": 1191,
                "width": 828,
                "x": 137,
                "y": 378
              },
              "remark": "识别图标bl_baoxiaoxing-done.png并点击",
              "template": "../image_templates/bl_baoxiaoxing-done.png",
              "threshold": 0.88,
              "timeout_sec": 8,
              "type": "find_image_click"
            },
            {
              "remark": "等待2秒",
              "seconds": 2,
              "type": "wait"
            },
            {
