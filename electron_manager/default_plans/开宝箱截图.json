{
  "actions": [
    {
      "type": "loop",
      "count": -1,
      "actions": [
        {
          "type": "if_image",
          "templates": [
            "../image_templates/bl_baoxiaoxing_1080x1920.png",
            "../image_templates/bl_baoxiaoxing.png"
          ],
          "max_candidates": 32,
          "threshold": 0.8,
          "min_color_similarity": 0.75,
          "scales": [
            1.0
          ],
          "timeout_sec": 8,
          "interval_sec": 0.6,
          "remark": "全屏识别放大镜按钮",
          "then_actions": [
            {
              "type": "log",
              "message": "全屏检测到放大镜按钮，点击本次匹配坐标"
            },
            {
              "type": "click_match",
              "remark": "点击放大镜按钮"
            },
            {
              "type": "wait",
              "seconds": 1,
              "remark": "放大镜已点击，等待确定弹框"
            },
            {
              "type": "log",
              "message": "开始识别确认按钮，优先绿色领取按钮，其次视频确认图标"
            },
            {
              "type": "if_image",
              "template": "../image_templates/baoxiang_claim.png",
              "region": {
                "x": 311,
                "y": 1107,
                "width": 462,
                "height": 250
              },
              "threshold": 0.8,
              "timeout_sec": 8,
              "interval_sec": 0.6,
              "remark": "识别确定按钮",
              "then_actions": [
                {
                  "type": "click_match",
                  "remark": "点击识别到的确认按钮"
                },
                {
                  "type": "wait",
                  "seconds": 7,
                  "remark": "确定已点击，等待物品列表弹框"
                },
                {
                  "type": "log",
                  "message": "确认按钮已点击，物品列表弹框预计已出现，开始保存截图"
                },
                {
                  "type": "save_screenshot",
                  "analyze_chest_items": true,
                  "defer_chest_analysis": true,
                  "storage_format": "webp",
                  "crop_chest_result": true,
                  "dir": "../diagnostics/chest_results",
                  "pair_key": "chest_result",
                  "stage": "single",
                  "label": "items",
                  "remark": "保存开宝箱物品列表"
                },
                {
                  "type": "log",
                  "message": "物品列表截图已保存，准备关闭弹框"
                },
                {
                  "type": "click",
                  "x": 530,
                  "y": 1450,
                  "remark": "关闭物品列表弹框"
                },
                {
                  "type": "analyze_chest_results",
                  "dir": "../diagnostics/chest_results",
                  "remark": "关闭弹框后更新开宝箱记录"
                },
                {
                  "type": "wait",
                  "seconds": "$loop_time",
                  "remark": "等待下一次开宝箱"
                }
              ],
              "else_actions": [
                {
                  "type": "if_image",
                  "template": "../image_templates/baoxiang_video_confirm.png",
                  "region": {
                    "x": 350,
                    "y": 1100,
                    "width": 400,
                    "height": 220
                  },
                  "threshold": 0.8,
                  "timeout_sec": 8,
                  "interval_sec": 0.6,
                  "remark": "识别完整视频确认按钮",
                  "then_actions": [
                    {
                      "type": "click_match",
                      "remark": "点击视频确认按钮"
                    },
                    {
                      "type": "wait",
                      "seconds": 7,
                      "remark": "视频确认已点击，等待物品列表弹框"
                    },
                    {
                      "type": "log",
                      "message": "视频确认已点击，广告额外奖励弹框预计已出现，开始保存第一份物品截图"
                    },
                    {
                      "type": "save_screenshot",
                      "analyze_chest_items": true,
                      "defer_chest_analysis": true,
                      "storage_format": "webp",
                      "crop_chest_result": true,
                      "dir": "../diagnostics/chest_results",
                      "pair_key": "chest_video_extra",
                      "stage": "single",
                      "label": "video_bonus_items",
                      "remark": "保存广告额外宝箱物品列表"
                    },
                    {
                      "type": "log",
                      "message": "广告额外奖励截图已保存，准备关闭第一层奖励弹框"
                    },
                    {
                      "type": "click",
                      "x": 530,
                      "y": 1450,
                      "remark": "关闭广告额外奖励弹框"
                    },
                    {
                      "type": "wait",
                      "seconds": 7,
                      "remark": "等待普通宝箱奖励弹框"
                    },
                    {
                      "type": "log",
                      "message": "普通宝箱奖励弹框预计已出现，开始保存第二份物品截图"
                    },
                    {
                      "type": "save_screenshot",
                  "analyze_chest_items": true,
                  "storage_format": "webp",
                  "crop_chest_result": true,
                  "dir": "../diagnostics/chest_results",
                      "pair_key": "chest_normal",
                      "stage": "single",
                      "label": "normal_items",
                      "remark": "保存普通宝箱物品列表"
                    },
                    {
                      "type": "log",
                      "message": "普通宝箱奖励截图已保存，准备关闭第二层奖励弹框"
                    },
                    {
                      "type": "click",
                      "x": 530,
                      "y": 1450,
                      "remark": "关闭普通宝箱奖励弹框"
                    },
                    {
                      "type": "analyze_chest_results",
                      "dir": "../diagnostics/chest_results",
                      "remark": "关闭弹框后更新开宝箱记录"
                    },
                    {
                      "type": "wait",
                      "seconds": "$loop_time",
                      "remark": "等待下一次开宝箱"
                    }
                  ],
                  "else_actions": [
                    {
                      "type": "log",
                      "message": "未检测到绿色领取或完整视频确认按钮，宝箱暂不可打开；结束本轮且不截图、不关闭弹框"
                    },
                    {
                      "type": "wait",
                      "seconds": "$loop_time",
                      "remark": "等待下一次检测"
                    }
                  ]
                }
              ]
            }
          ],
          "else_actions": [
            {
              "type": "log",
              "message": "全屏未检测到放大镜按钮，本轮跳过"
            },
            {
              "type": "wait",
              "seconds": "$loop_time",
              "remark": "等待下一次检测"
            }
          ]
        }
      ]
    }
  ],
  "device": "127.0.0.1:5555",
  "screen_size": {
    "width": 1080,
    "height": 1920
  },
  "jitter_px": 3,
  "max_runtime_sec": 0,
  "variables": [
    {
      "name": "loop_time",
      "value": "5",
      "note": "循环等待时间"
    }
  ]
}
